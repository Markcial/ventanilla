---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ventanilla — agent-native paperwork</title>
  </head>
  <body>
    <header class="top">
      <h1>Ventanilla</h1>
      <p class="tagline">Spanish freelance paperwork, prepared by your agent and decided by you.</p>
      <p id="webmcp-status" class="status" data-status="unknown">Checking WebMCP support…</p>
    </header>

    <main>
      <section class="panel">
        <h2>Your details</h2>
        <p class="note">Stored only in this browser. Nothing is sent to a server.</p>
        <dl id="profile" class="profile"><dd>Loading…</dd></dl>
      </section>

      <section class="panel">
        <h2>What you owe, and when</h2>
        <p class="note">Ask your agent: <em>"what do I have to file next?"</em></p>
        <div id="obligations" data-count="0"><p class="empty">Nothing loaded yet.</p></div>
      </section>
    </main>

    <footer>
      <p>Deadlines shift to the next working day when they land on a weekend. Public holidays are not applied — this is a demo, not filing software.</p>
    </footer>

    <script>
      import { registerTools } from '../tools/register';
      import { isSupported } from '../lib/webmcp';
      import { getProfile, today } from '../lib/db';
      import { upcomingObligations } from '../lib/obligations';
      import { renderObligations } from '../lib/render';

      const statusEl = document.getElementById('webmcp-status')!;
      const names = await registerTools();

      if (isSupported()) {
        statusEl.dataset.status = 'ready';
        statusEl.dataset.tools = names.join(',');
        statusEl.textContent = `WebMCP ready — ${names.length} tools available to your agent: ${names.join(', ')}`;
      } else {
        statusEl.dataset.status = 'unsupported';
        statusEl.textContent = 'WebMCP not detected. Open in the ChatGPT desktop browser, or Chrome 149+ with the WebMCP trial enabled. The page still works on its own.';
      }

      const profile = await getProfile();
      document.getElementById('profile')!.innerHTML = `
        <dt>Name</dt><dd>${profile.name}</dd>
        <dt>Tax ID</dt><dd>${profile.nif}</dd>
        <dt>Trading since</dt><dd>${profile.startedTrading}</dd>
        <dt>VAT regime</dt><dd>${profile.vatRegime}</dd>
        <dt>Income tax</dt><dd>${profile.incomeTaxMethod === 'direct' ? 'direct assessment' : 'modules'}</dd>
        <dt>Employees</dt><dd>${profile.hasEmployees ? 'yes' : 'no'}</dd>`;

      renderObligations(upcomingObligations(profile, today(), 365));
    </script>

    <style is:global>
      :root {
        --ink: #14171a; --muted: #5b6570; --line: #e3e7eb;
        --bg: #fbfcfd; --panel: #fff; --accent: #12507a; --warn: #a4400a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font: 16px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      .top { padding: 2.5rem 1.5rem 1.5rem; max-width: 62rem; margin: 0 auto; }
      h1 { margin: 0; font-size: 1.9rem; letter-spacing: -0.02em; }
      .tagline { margin: .35rem 0 1rem; color: var(--muted); }
      .status {
        display: inline-block; margin: 0; padding: .45rem .7rem; border-radius: 6px;
        font-size: .85rem; background: #eef2f5; color: var(--muted);
      }
      .status[data-status="ready"] { background: #e8f4ec; color: #1d5c33; }
      .status[data-status="unsupported"] { background: #fcf1e8; color: var(--warn); }
      main { max-width: 62rem; margin: 0 auto; padding: 0 1.5rem 2rem;
             display: grid; gap: 1.25rem; grid-template-columns: minmax(0,1fr); }
      @media (min-width: 56rem) { main { grid-template-columns: 20rem minmax(0,1fr); align-items: start; } }
      .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.15rem 1.25rem; }
      .panel h2 { margin: 0 0 .2rem; font-size: 1rem; letter-spacing: -0.01em; }
      .note { margin: 0 0 .9rem; font-size: .82rem; color: var(--muted); }
      .profile { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: .3rem .8rem; font-size: .88rem; }
      .profile dt { color: var(--muted); }
      .profile dd { margin: 0; }
      #obligations { display: grid; gap: .7rem; transition: background-color .5s ease; border-radius: 8px; }
      #obligations.touched { background: #fff8dd; }
      .obligation { border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 8px; padding: .8rem .95rem; }
      .obligation.soon { border-left-color: var(--warn); }
      .obligation header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
      .obligation h3 { margin: 0; font-size: .95rem; }
      .period { color: var(--muted); font-weight: 400; }
      .days { font-size: .8rem; color: var(--muted); white-space: nowrap; }
      .obligation .title { margin: .2rem 0 .5rem; font-size: .88rem; }
      .obligation dl { margin: 0 0 .5rem; display: grid; grid-template-columns: auto 1fr; gap: .15rem .8rem; font-size: .82rem; }
      .obligation dt { color: var(--muted); }
      .obligation dd { margin: 0; font-variant-numeric: tabular-nums; }
      .reason { margin: 0; font-size: .8rem; color: var(--muted); }
      .empty { margin: 0; color: var(--muted); font-size: .88rem; }
      footer { max-width: 62rem; margin: 0 auto; padding: 0 1.5rem 3rem; color: var(--muted); font-size: .78rem; }
    </style>
  </body>
</html>
