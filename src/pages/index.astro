---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ventanilla — agent-native paperwork</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  </head>
  <body data-mode="demo">
    <header class="masthead">
      <div class="masthead-row">
        <div class="brand">
          <h1>Ventanilla</h1>
          <p class="tagline">Your agent prepares the paperwork. You decide.</p>
        </div>
        <div class="controls">
          <div class="modes" role="group" aria-label="Mode">
            <button type="button" data-set-mode="demo" aria-pressed="true">Demo</button>
            <button type="button" data-set-mode="real" aria-pressed="false">Real</button>
          </div>
          <p id="webmcp-status" class="status" data-status="unknown">Checking…</p>
        </div>
      </div>
      <p id="mode-strip" class="mode-strip" data-mode="demo">Loading…</p>

      <nav class="tabs" role="tablist" aria-label="Sections">
        <button type="button" role="tab" data-tab="invoices" aria-selected="true" aria-controls="panel-invoices">
          Invoices <span class="count"></span>
        </button>
        <button type="button" role="tab" data-tab="deadlines" aria-selected="false" aria-controls="panel-deadlines" tabindex="-1">
          Deadlines
        </button>
        <button type="button" role="tab" data-tab="vat-return" aria-selected="false" aria-controls="panel-vat-return" tabindex="-1">
          Modelo 303
        </button>
        <button type="button" role="tab" data-tab="submission" aria-selected="false" aria-controls="panel-submission" tabindex="-1">
          Submission
        </button>
        <button type="button" role="tab" data-tab="profile" aria-selected="false" aria-controls="panel-profile" tabindex="-1">
          Profile
        </button>
      </nav>
    </header>

    <main>
      <section id="panel-invoices" data-panel="invoices" role="tabpanel" aria-labelledby="tab-invoices">
        <div class="panel-head">
          <p class="prompt">Say to your agent: <em>“invoice Astillero Ribera 800 euros plus VAT”</em>
            — or do it yourself.</p>
          <button id="open-new-invoice" type="button">New invoice</button>
        </div>
        <div id="invoices" data-count="0"><p class="empty">No invoices yet.</p></div>
      </section>

      <section id="panel-deadlines" data-panel="deadlines" role="tabpanel" hidden>
        <p class="prompt">Say to your agent: <em>“what do I have to file next?”</em></p>
        <div id="obligations" data-count="0">
          <p class="empty">Nothing here yet — on purpose.</p>
          <p class="empty small">This stays empty until something fills it, so when an agent answers
            you can tell it called the tool instead of reading the screen.</p>
          <button id="load-obligations" type="button">Show them myself</button>
        </div>
      </section>

      <section id="panel-vat-return" data-panel="vat-return" role="tabpanel" hidden>
        <div class="panel-head">
          <p class="prompt">Say to your agent: <em>“work out my VAT return for last quarter”</em>
            — or pick a quarter.</p>
          <form id="pick-quarter" class="picker">
            <label>Quarter
              <select name="quarter">
                <option value="1">1T</option><option value="2">2T</option>
                <option value="3" selected>3T</option><option value="4">4T</option>
              </select>
            </label>
            <label>Year<input name="year" type="number" min="2000" max="2100" value="2026" /></label>
            <button type="submit">Work it out</button>
          </form>
        </div>
        <div id="vat-return">
          <p class="empty">Nothing worked out yet.</p>
          <p class="empty small">The boxes are computed from the invoices on record, numbered as the
            official form numbers them, and shown with whatever they could not account for.</p>
        </div>
      </section>

      <section id="panel-submission" data-panel="submission" role="tabpanel" hidden>
        <p class="prompt">Say to your agent: <em>“prepare the AEAT submission for that invoice”</em></p>
        <div id="submission">
          <p class="empty">Nothing prepared yet.</p>
          <p class="empty small">Ventanilla builds the SOAP request the tax agency expects and gives
            it to you. It never sends it — and no web page could: the endpoint answers no CORS
            headers and requires a client certificate.</p>
        </div>
      </section>

      <section id="panel-profile" data-panel="profile" role="tabpanel" hidden>
        <p class="prompt">Stored only in this browser. Nothing is sent to a server.</p>
        <div id="profile" data-mode="demo"><p class="empty">Loading…</p></div>
      </section>
    </main>

    <dialog id="new-invoice">
      <form method="dialog" id="new-invoice-form">
        <h2>New invoice</h2>
        <p class="dialog-note">The same code the agent calls. Nothing it can do here is
          unavailable to you.</p>
        <label>Client name<input name="clientName" required autocomplete="off" /></label>
        <label>Client tax ID (NIF)<input name="clientNif" required autocomplete="off" /></label>
        <label>Amount before VAT (EUR)<input name="baseEuros" type="number" step="0.01" min="0.01" required /></label>
        <label>VAT rate
          <select name="vatRate">
            <option value="21" selected>21%</option>
            <option value="10">10%</option>
            <option value="4">4%</option>
            <option value="0">0% — none charged</option>
          </select>
        </label>
        <label id="treatment-field" hidden>Why no VAT
          <select name="vatTreatment">
            <option value="">Choose one…</option>
            <option value="E1">E1 — exempt</option><option value="E2">E2 — exempt</option>
            <option value="E3">E3 — exempt</option><option value="E4">E4 — exempt</option>
            <option value="E5">E5 — exempt</option><option value="E6">E6 — exempt</option>
            <option value="N1">N1 — outside the scope</option>
            <option value="N2">N2 — outside the scope</option>
          </select>
        </label>
        <label>Issue date<input name="issuedOn" type="date" /></label>
        <p id="new-invoice-error" class="dialog-error" hidden></p>
        <menu>
          <button type="button" id="cancel-new-invoice" class="ghost">Cancel</button>
          <button type="submit" id="save-new-invoice">Issue it</button>
        </menu>
      </form>
    </dialog>

    <footer>
      <p>Deadlines move to the next working day when they land on a weekend; public holidays are not
        applied. Nothing is ever submitted to the AEAT — filing on someone else’s behalf needs
        registered <em>colaborador social</em> status.</p>
    </footer>

    <script>
      import { registerTools } from '../tools/register';
      import { isSupported } from '../lib/webmcp';
      import { getMode, setMode, getProfile, saveProfile, listInvoices, today } from '../lib/db';
      import { upcomingObligations } from '../lib/obligations';
      import {
        renderObligations, renderProfile, renderModeStrip, renderInvoices,
        renderVatReturn, renderSubmission, focusTab,
      } from '../lib/render';
      import { createInvoice, computeVatReturn, prepareSubmission } from '../lib/actions';
      import { PRE_303_FORM } from '../tools/prepare-vat-return';
      import type { Mode } from '../lib/mode';
      import type { Profile } from '../lib/types';

      // Register before touching IndexedDB. Extensions that snapshot the tool list
      // at page load would otherwise scan while storage was still opening and
      // report a page with no tools on it.
      const statusEl = document.getElementById('webmcp-status')!;
      const names = await registerTools();

      if (isSupported()) {
        statusEl.dataset.status = 'ready';
        statusEl.dataset.tools = names.join(',');
        statusEl.textContent = `${names.length} tools live`;
        statusEl.title = `Available to your agent: ${names.join(', ')}`;
      } else {
        statusEl.dataset.status = 'unsupported';
        statusEl.textContent = 'No WebMCP';
        statusEl.title = 'Open in the ChatGPT desktop browser, or Chrome 149+ with the WebMCP trial enabled. The page still works on its own.';
      }

      let mode: Mode = await getMode();
      let profile: Profile = await getProfile(mode);

      const EMPTY_DEADLINES = `
        <p class="empty">Nothing here yet — on purpose.</p>
        <p class="empty small">This stays empty until something fills it, so when an agent answers
          you can tell it called the tool instead of reading the screen.</p>
        <button id="load-obligations" type="button">Show them myself</button>`;

      function clearObligations() {
        const host = document.getElementById('obligations')!;
        host.dataset.count = '0';
        host.innerHTML = EMPTY_DEADLINES;
        wireLoadButton();
      }

      function wireLoadButton() {
        document.getElementById('load-obligations')?.addEventListener('click', () => {
          renderObligations(upcomingObligations(profile, today(), 365));
        });
      }

      function wireProfileForm() {
        const form = document.getElementById('profile-form') as HTMLFormElement | null;
        form?.addEventListener('submit', async event => {
          event.preventDefault();
          const data = new FormData(form);
          profile = {
            id: mode,
            name: String(data.get('name') ?? ''),
            nif: String(data.get('nif') ?? ''),
            startedTrading: String(data.get('startedTrading') ?? ''),
            vatRegime: data.get('vatRegime') === 'exempt' ? 'exempt' : 'general',
            incomeTaxMethod: data.get('incomeTaxMethod') === 'modules' ? 'modules' : 'direct',
            hasEmployees: data.get('hasEmployees') === 'on',
          };
          await saveProfile(profile);
          const saved = document.getElementById('profile-saved');
          if (saved) { saved.hidden = false; setTimeout(() => { saved.hidden = true; }, 1600); }
          clearObligations();
        });
      }

      async function applyMode(next: Mode) {
        mode = next;
        await setMode(next);
        profile = await getProfile(next);
        renderModeStrip(next);
        renderProfile(profile, next);
        wireProfileForm();
        // Invoices already exist as records, so showing them is not pre-rendering a
        // tool's answer — unlike the deadlines panel, which must stay empty.
        await renderInvoices(await listInvoices(next), profile.nif);
        clearObligations();
      }

      // Everything an agent can do, a person can do here, through the same functions in
      // lib/actions. An agent able to do something the person cannot would mean the
      // person was not really the one in charge.
      const dialog = document.getElementById('new-invoice') as HTMLDialogElement;
      const invoiceForm = document.getElementById('new-invoice-form') as HTMLFormElement;
      const rateSelect = invoiceForm.elements.namedItem('vatRate') as HTMLSelectElement;
      const treatmentField = document.getElementById('treatment-field') as HTMLElement;
      const invoiceError = document.getElementById('new-invoice-error') as HTMLElement;

      // Asking why inside the dialog keeps the page from reflowing under the reader.
      rateSelect.addEventListener('change', () => {
        treatmentField.hidden = rateSelect.value !== '0';
      });

      document.getElementById('open-new-invoice')?.addEventListener('click', () => {
        invoiceError.hidden = true;
        dialog.showModal();
      });
      document.getElementById('cancel-new-invoice')?.addEventListener('click', () => dialog.close());

      document.getElementById('save-new-invoice')?.addEventListener('click', async event => {
        event.preventDefault();
        if (!invoiceForm.reportValidity()) return;
        const data = new FormData(invoiceForm);
        const result = await createInvoice({
          clientName: String(data.get('clientName') ?? ''),
          clientNif: String(data.get('clientNif') ?? ''),
          baseEuros: Number(data.get('baseEuros')),
          vatRate: Number(data.get('vatRate')),
          issuedOn: String(data.get('issuedOn') ?? '') || undefined,
          vatTreatment: String(data.get('vatTreatment') ?? '') || undefined,
        });
        if (!result.ok) {
          invoiceError.textContent = result.reason;
          invoiceError.hidden = false;
          return;
        }
        const { invoice, invoices } = result.value;
        await renderInvoices(invoices, profile.nif, invoice.id);
        invoiceForm.reset();
        treatmentField.hidden = true;
        dialog.close();
      });

      document.getElementById('pick-quarter')?.addEventListener('submit', async event => {
        event.preventDefault();
        const data = new FormData(event.target as HTMLFormElement);
        const result = await computeVatReturn(
          Number(data.get('year')), Number(data.get('quarter')) as 1 | 2 | 3 | 4);
        if (!result.ok) return;
        const { vat, boxes, invoiceCount } = result.value;
        renderVatReturn({ vat, boxes, formUrl: PRE_303_FORM, invoiceCount });
      });

      // Delegated: the invoice list is re-rendered whenever it changes.
      document.addEventListener('click', async event => {
        const button = (event.target as HTMLElement).closest('[data-prepare]');
        if (!button) return;
        const result = await prepareSubmission(
          (button as HTMLElement).dataset.prepare, '0.1.0');
        if (result.ok) renderSubmission(result.value);
      });

      // Mode is a human decision. It is deliberately not reachable from a tool:
      // an agent that could move someone into real mode could get them to sign
      // something real while they believed they were trying a demo.
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-set-mode]')) {
        button.addEventListener('click', () => applyMode(button.dataset.setMode as Mode));
      }

      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
      for (const [index, tab] of tabs.entries()) {
        tab.addEventListener('click', () => focusTab(tab.dataset.tab!));
        tab.addEventListener('keydown', event => {
          const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          event.preventDefault();
          const next = tabs[(index + step + tabs.length) % tabs.length];
          focusTab(next.dataset.tab!);
          next.focus();
        });
      }

      await applyMode(mode);
      focusTab('invoices');
    </script>

    <style is:global>
      /*
        A register, not a dashboard. Everything that matters here is a series, a
        date, an amount or a fingerprint, so the monospace carries the personality
        and the sans stays out of the way.
      */
      :root {
        --ink: #16191d;
        --ink-soft: #5a6470;
        --ink-faint: #8b949d;
        --paper: #f4f6f5;
        --card: #ffffff;
        --rule: #dde3e1;
        --seal: #0f5f56;
        --seal-wash: #e7f0ee;
        --flag: #b4341c;
        --sans: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      body[data-mode="real"] { --seal: #8a4b12; --seal-wash: #f7efe4; }

      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--paper); color: var(--ink);
        font: 400 16px/1.5 var(--sans);
        -webkit-font-smoothing: antialiased;
      }
      :focus-visible { outline: 2px solid var(--seal); outline-offset: 2px; }

      .masthead { background: var(--card); border-bottom: 1px solid var(--rule); }
      .masthead-row {
        max-width: 62rem; margin: 0 auto; padding: 1.4rem 1.5rem .9rem;
        display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-start; justify-content: space-between;
      }
      .brand h1 {
        margin: 0; font-size: 1.5rem; font-weight: 600; letter-spacing: -0.03em;
      }
      .tagline { margin: .15rem 0 0; color: var(--ink-soft); font-size: .88rem; }
      .controls { display: flex; align-items: center; gap: .6rem; }

      .modes { display: inline-flex; border: 1px solid var(--rule); border-radius: 7px; overflow: hidden; }
      .modes button {
        appearance: none; border: 0; background: var(--card); cursor: pointer;
        font: 500 .8rem var(--sans); padding: .4rem .9rem; color: var(--ink-soft);
      }
      .modes button + button { border-left: 1px solid var(--rule); }
      .modes button[aria-pressed="true"] { background: var(--seal); color: #fff; }

      .status {
        margin: 0; padding: .35rem .6rem; border-radius: 6px; white-space: nowrap;
        font: 500 .74rem var(--mono); background: #eef1f0; color: var(--ink-soft);
      }
      .status[data-status="ready"] { background: var(--seal-wash); color: var(--seal); }
      .status[data-status="unsupported"] { background: #fbeee9; color: var(--flag); }

      .mode-strip {
        max-width: 62rem; margin: 0 auto; padding: 0 1.5rem 1rem;
        font-size: .8rem; color: var(--ink-soft);
      }

      .tabs {
        max-width: 62rem; margin: 0 auto; padding: 0 1.5rem;
        display: flex; gap: .25rem;
      }
      .tabs button {
        appearance: none; background: none; border: 0; cursor: pointer;
        font: 500 .88rem var(--sans); color: var(--ink-soft);
        padding: .55rem .85rem; border-bottom: 2px solid transparent;
        display: inline-flex; align-items: center; gap: .4rem;
      }
      .tabs button:hover { color: var(--ink); }
      .tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--seal); }
      .tabs .count:not(:empty) {
        font: 500 .7rem var(--mono); background: var(--seal-wash); color: var(--seal);
        border-radius: 20px; padding: .1rem .45rem;
      }

      main { max-width: 62rem; margin: 0 auto; padding: 1.5rem 1.5rem 2.5rem; }
      .prompt { margin: 0 0 1.1rem; font-size: .85rem; color: var(--ink-soft); }
      .prompt em { color: var(--ink); font-style: italic; }

      .empty { margin: 0 0 .5rem; color: var(--ink-soft); font-size: .9rem; }
      .empty.small { font-size: .82rem; max-width: 34rem; }

      /* The chain. Each record hangs off the fingerprint of the one below it. */
      #invoices { display: grid; gap: 0; border-radius: 10px; }
      #invoices.touched, #obligations.touched {
        animation: notice 1.1s ease-out;
      }
      @keyframes notice {
        from { box-shadow: 0 0 0 4px var(--seal-wash); }
        to { box-shadow: 0 0 0 4px transparent; }
      }
      .invoice {
        position: relative; background: var(--card);
        border: 1px solid var(--rule); border-radius: 9px;
        padding: .9rem 1.05rem; margin-bottom: 1.6rem;
        display: flex; gap: 1.1rem; align-items: flex-start; justify-content: space-between;
      }
      .invoice:last-child { margin-bottom: 0; }
      .invoice.fresh { border-color: var(--seal); box-shadow: 0 0 0 3px var(--seal-wash); }
      .invoice-body { min-width: 0; flex: 1; }

      .link {
        position: absolute; left: 1.05rem; right: 1.05rem; bottom: -1.6rem; height: 1.6rem;
        margin: 0; display: flex; align-items: center; gap: .5rem;
        font-size: .68rem; color: var(--ink-faint);
      }
      .link::before {
        content: ""; position: absolute; left: -.1rem; top: 0; bottom: 0;
        border-left: 2px solid var(--ink-faint); opacity: .45;
      }
      .link-label { padding-left: .8rem; text-transform: uppercase; letter-spacing: .07em; }
      .link code {
        font: 400 .62rem var(--mono); color: var(--ink-faint);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .invoice:last-child .link::before { border-left-style: dashed; }
      .link-root .link-label { color: var(--seal); }

      .invoice header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
      .invoice h3 { margin: 0; font: 500 .92rem var(--mono); letter-spacing: -0.01em; }
      .invoice .total { font: 500 .95rem var(--mono); white-space: nowrap; }
      .invoice .client { margin: .3rem 0 .6rem; font-size: .88rem; }
      .invoice .nif { font: 400 .74rem var(--mono); color: var(--ink-faint); margin-left: .3rem; }
      .invoice dl {
        margin: 0; display: grid; grid-template-columns: auto auto; gap: .1rem .9rem;
        justify-content: start; font-size: .78rem;
      }
      .invoice dt { color: var(--ink-soft); }
      .invoice dd { margin: 0; font-family: var(--mono); font-size: .74rem; }
      .hash { margin: .6rem 0 0; font-size: .66rem; display: grid; gap: .1rem; }
      .hash span { color: var(--ink-soft); text-transform: uppercase; letter-spacing: .07em; }
      .hash code { font: 400 .64rem/1.35 var(--mono); color: var(--ink); word-break: break-all; }

      .qr { margin: 0; flex: 0 0 auto; text-align: center; }
      .qr svg { display: block; width: 84px; height: 84px; }
      .qr figcaption {
        margin-top: .3rem; font: 400 .6rem var(--mono);
        color: var(--ink-faint); text-transform: uppercase; letter-spacing: .06em;
      }

      #obligations { display: grid; gap: .65rem; border-radius: 10px; }
      .obligation {
        background: var(--card); border: 1px solid var(--rule); border-radius: 9px;
        border-left: 3px solid var(--seal); padding: .85rem 1rem;
      }
      .obligation.soon { border-left-color: var(--flag); }
      .obligation header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
      .obligation h3 { margin: 0; font-size: .95rem; font-weight: 600; }
      .period { font: 400 .8rem var(--mono); color: var(--ink-soft); margin-left: .2rem; }
      .days { font: 500 .78rem var(--mono); color: var(--ink-soft); white-space: nowrap; }
      .obligation .what { margin: .1rem 0 .55rem; font-size: .86rem; color: var(--ink-soft); }
      .obligation dl {
        margin: 0 0 .5rem; display: grid; grid-template-columns: auto auto;
        justify-content: start; gap: .1rem .9rem; font-size: .78rem;
      }
      .obligation dt { color: var(--ink-soft); }
      .obligation dd { margin: 0; font-family: var(--mono); font-size: .74rem; }
      .obligation dd strong { font-weight: 500; color: var(--seal); }
      .obligation.soon dd strong { color: var(--flag); }
      .reason { margin: 0; font-size: .78rem; color: var(--ink-soft); max-width: 46rem; }

      .return-head, .submission-head {
        display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-start;
        justify-content: space-between; margin-bottom: .8rem;
      }
      .return-head h3, .submission-head h3 { margin: 0; font: 500 .95rem var(--mono); }
      .result { margin: 0; text-align: right; }
      .result span { display: block; font-size: .72rem; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .07em; }
      .result strong { font: 500 1.15rem var(--mono); }
      .warn ul { margin: .3rem 0 0; padding-left: 1.1rem; }
      .warn li { margin-bottom: .2rem; }
      .warn p { margin: 0 0 .2rem; }
      .warn p + p { margin-top: .6rem; }
      .boxes { border-collapse: collapse; width: 100%; max-width: 44rem; font-size: .82rem; }
      .boxes th {
        text-align: left; font: 500 .7rem var(--sans); color: var(--ink-soft);
        text-transform: uppercase; letter-spacing: .07em; padding: .3rem .6rem .35rem 0;
        border-bottom: 1px solid var(--rule);
      }
      .boxes td { padding: .3rem .6rem .3rem 0; border-bottom: 1px solid var(--rule); }
      .boxes .num { font: 500 .78rem var(--mono); color: var(--seal); white-space: nowrap; width: 4rem; }
      .boxes .val { font: 500 .82rem var(--mono); text-align: right; white-space: nowrap; }
      .boxes tr:last-child td { border-bottom: 0; }
      .filing { margin: 0 0 .5rem; font-size: .82rem; color: var(--ink-soft); max-width: 46rem; }
      .formlink { font: 400 .76rem var(--mono); color: var(--seal); word-break: break-all; }
      .endpoint { margin: .15rem 0 0; font: 400 .72rem var(--mono); color: var(--ink-faint); word-break: break-all; }
      #download-submission {
        padding: .48rem 1rem; font: 500 .85rem var(--sans); border-radius: 7px;
        background: var(--seal); color: #fff; border: 1px solid transparent; cursor: pointer;
        white-space: nowrap;
      }
      .warn {
        margin: 0 0 .9rem; padding: .6rem .8rem; border-radius: 7px;
        background: #fbeee9; color: #7d2a13; font-size: .8rem; max-width: 46rem;
      }
      .send {
        margin: 0 0 1.1rem; padding: .9rem 1rem;
        border: 1px solid var(--seal); border-radius: 9px; background: var(--seal-wash);
      }
      .send button {
        padding: .55rem 1.1rem; font: 500 .88rem var(--sans); cursor: pointer;
        background: var(--seal); color: #fff; border: 1px solid transparent; border-radius: 7px;
      }
      .send-note { margin: .55rem 0 0; font-size: .78rem; color: var(--ink-soft); max-width: 40rem; }
      #submission h4 { margin: 1.2rem 0 .4rem; font-size: .85rem; }
      .envelope, .howto {
        margin: 0; padding: .85rem 1rem; background: var(--card);
        border: 1px solid var(--rule); border-radius: 8px;
        overflow-x: auto; max-height: 26rem; overflow-y: auto;
      }
      .envelope code, .howto code { font: 400 .7rem/1.55 var(--mono); color: var(--ink); white-space: pre; }

      .panel-head {
        display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-start;
        justify-content: space-between; margin-bottom: 1.1rem;
      }
      .panel-head .prompt { margin: 0; max-width: 34rem; }
      #open-new-invoice, .picker button {
        padding: .48rem 1rem; font: 500 .85rem var(--sans); cursor: pointer;
        background: var(--seal); color: #fff; border: 1px solid transparent; border-radius: 7px;
        white-space: nowrap;
      }
      .picker { display: flex; gap: .5rem; align-items: flex-end; }
      .picker label { display: grid; gap: .15rem; font-size: .72rem; color: var(--ink-soft); }
      .picker select, .picker input {
        font: 400 .82rem var(--mono); padding: .38rem .45rem; color: var(--ink);
        border: 1px solid var(--rule); border-radius: 6px; background: var(--card);
      }
      .picker input { width: 5.5rem; }

      .invoice-side { display: grid; gap: .45rem; justify-items: center; flex: 0 0 auto; }
      .prepare {
        font: 500 .72rem var(--sans); padding: .3rem .6rem; cursor: pointer;
        background: var(--card); color: var(--seal);
        border: 1px solid var(--rule); border-radius: 6px; white-space: nowrap;
      }
      .prepare:hover { background: var(--seal-wash); }

      dialog {
        border: 1px solid var(--rule); border-radius: 12px; padding: 1.4rem 1.5rem;
        max-width: 26rem; width: calc(100% - 2rem); background: var(--card); color: var(--ink);
      }
      dialog::backdrop { background: rgba(16, 22, 26, .38); }
      dialog[open] { animation: lift .18s cubic-bezier(.2, .7, .3, 1); }
      dialog[open]::backdrop { animation: fade .18s ease; }
      @keyframes lift { from { opacity: 0; transform: translateY(6px) scale(.985); } }
      @keyframes fade { from { opacity: 0; } }
      dialog h2 { margin: 0 0 .2rem; font-size: 1rem; }
      .dialog-note { margin: 0 0 1rem; font-size: .78rem; color: var(--ink-soft); }
      dialog label { display: grid; gap: .2rem; margin-bottom: .7rem; font-size: .78rem; color: var(--ink-soft); }
      dialog input, dialog select {
        font: 400 .88rem var(--sans); padding: .45rem .55rem; color: var(--ink);
        border: 1px solid var(--rule); border-radius: 6px; background: var(--card);
      }
      dialog input[name="clientNif"], dialog input[type="date"], dialog input[type="number"] {
        font-family: var(--mono); font-size: .82rem;
      }
      .dialog-error {
        margin: 0 0 .8rem; padding: .55rem .7rem; border-radius: 7px;
        background: #fbeee9; color: #7d2a13; font-size: .78rem;
      }
      dialog menu { display: flex; gap: .5rem; justify-content: flex-end; margin: .3rem 0 0; padding: 0; }
      dialog menu button {
        padding: .45rem 1rem; font: 500 .85rem var(--sans); cursor: pointer;
        border-radius: 7px; border: 1px solid transparent; background: var(--seal); color: #fff;
      }
      dialog menu .ghost { background: var(--card); color: var(--ink-soft); border-color: var(--rule); }

      .facts, .fields { max-width: 26rem; }
      .facts { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: .35rem 1rem; font-size: .88rem; }
      .facts dt { color: var(--ink-soft); }
      .facts dd { margin: 0; font-family: var(--mono); font-size: .82rem; }
      .fields { display: grid; gap: .7rem; }
      .fields label { display: grid; gap: .25rem; font-size: .8rem; color: var(--ink-soft); }
      .fields label.check { grid-template-columns: auto 1fr; align-items: center; gap: .45rem; }
      .fields input, .fields select {
        font: 400 .88rem var(--sans); padding: .45rem .55rem; color: var(--ink);
        border: 1px solid var(--rule); border-radius: 6px; background: var(--card);
      }
      .fields input[name="nif"], .fields input[type="date"] { font-family: var(--mono); font-size: .82rem; }
      .fields input[type="checkbox"] { width: auto; justify-self: start; }
      .saved { font: 500 .78rem var(--mono); color: var(--seal); }

      .fields button, #load-obligations {
        justify-self: start; margin-top: .2rem; padding: .48rem 1rem;
        font: 500 .85rem var(--sans); border-radius: 7px; cursor: pointer;
        background: var(--seal); color: #fff; border: 1px solid transparent;
      }
      #load-obligations { background: var(--card); color: var(--seal); border-color: var(--rule); }
      #load-obligations:hover { background: var(--seal-wash); }

      footer {
        max-width: 62rem; margin: 0 auto; padding: 0 1.5rem 3rem;
        color: var(--ink-faint); font-size: .76rem;
      }
      footer p { max-width: 46rem; margin: 0; }

      @media (max-width: 34rem) {
        .invoice { flex-direction: column; }
        .qr { align-self: flex-start; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </body>
</html>
